{
  "private": true,
  "name": "@samchon/novels",
  "version": "0.1.0",
  "description": "Evidence-compiled English novel workspace.",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm --filter=./packages/** -r build",
    "check": "pnpm --filter=./packages/** -r check",
    "create:novel": "node config/scripts/create-novel-package.mjs",
    "ttsc": "pnpm --filter=./packages/** -r ttsc",
    "watch": "pnpm --filter=./packages/** -r --parallel watch"
  }
}
